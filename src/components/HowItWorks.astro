---
// "Como funciona" — step-by-step walkthrough reusing the locale-swapping
// screenshots (data-screenshot lets js/main.js switch pt-BR/en-US images).
// Three steps, in the order the app actually asks for them. Step 1 used to be
// "cadastre seus cartões" — the standalone card step that 12fdk/meugrana#363
// deleted from onboarding because half of everyone who abandoned quit on it.
// The card is now created inline from the parcela, so the site says the same.
// See MESSAGING.md in the app repo.
const steps = [
  {
    screenshot: 2,
    titleKey: "how.step1.title",
    title: "Cadastre uma parcela",
    descKey: "how.step1.desc",
    desc: "Loja, valor e em quantas vezes. O cartão você cria na hora, ali mesmo — sem formulário separado.",
    altKey: "screenshot2.alt",
    alt: "Parcelas — Acompanhamento de parcelamentos",
  },
  {
    screenshot: 3,
    titleKey: "how.step2.title",
    title: "Veja a projeção das próximas faturas",
    descKey: "how.step2.desc",
    desc: "Saiba hoje quanto vai pagar nos próximos 12 meses, com cada parcela já contabilizada.",
    altKey: "screenshot3.alt",
    alt: "Projeção — Faturas futuras",
  },
  {
    screenshot: 1,
    titleKey: "how.step3.title",
    title: "Receba o aviso antes do mês pesado",
    descKey: "how.step3.desc",
    desc: "Fechamento, vencimento e parcela pesada chegando: o MeuGrana avisa antes, não depois.",
    altKey: "screenshot1.alt",
    alt: "Dashboard — Resumo mensal",
  },
];
---

<section class="how-it-works" id="how-it-works" aria-label="How it works">
  <div class="container">
    <div class="section-header fade-in">
      <h2 data-i18n="how.title">Como funciona</h2>
      <p data-i18n="how.subtitle">Da primeira parcela ao controle total em três passos.</p>
    </div>
    <div class="how-steps">
      {
        steps.map((step, i) => (
          <div class="how-step fade-in">
            <div class="how-step-text">
              <span class="how-step-number" aria-hidden="true">
                {i + 1}
              </span>
              <h3 data-i18n={step.titleKey}>{step.title}</h3>
              <p data-i18n={step.descKey}>{step.desc}</p>
            </div>
            <div class="how-step-image">
              <div class="phone-frame">
                <img
                  src={`/images/screenshots/pt-BR/screenshot-${step.screenshot}.png`}
                  data-screenshot={step.screenshot}
                  data-i18n={step.altKey}
                  alt={step.alt}
                  width="320"
                  height="695"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
