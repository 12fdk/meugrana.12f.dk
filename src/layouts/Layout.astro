---
// Shared page shell: head metadata, favicons, stylesheet, Umami analytics.
// Pages pass their own title/description/canonical and extend the head via
// the named "head" slot (OG tags, structured data, extra styles).
import {
  SITE,
  ORG_ID,
  WEBSITE_ID,
  PERSON_ID,
  APP_STORE_URL,
  SITE_DESCRIPTION,
  IOS_REQUIREMENT_PT,
} from "../consts";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** Load css/style.css (the site stylesheet). The 404 page opts out. */
  siteStylesheet?: boolean;
  /** Load the Umami analytics script. The 404 page opts out. */
  analytics?: boolean;
  /**
   * Opt this page into the client-side PT/EN switcher in js/main.js.
   * Only set it on pages whose content is fully covered by `data-i18n`
   * attributes — currently just the homepage. Blog posts and the legal
   * pages are pt-BR only, and letting the switcher run there would set
   * document.lang="en" over Portuguese text (issue #64).
   */
  i18n?: boolean;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  siteStylesheet = true,
  analytics = true,
  i18n = false,
} = Astro.props;

// Site-wide brand entity graph: Organization + WebSite, referenced by
// page-level schema (SoftwareApplication author, BlogPosting publisher)
// via their @id anchors from consts.ts.
const siteEntities = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORG_ID,
      name: "MeuGrana",
      url: `${SITE}/`,
      description: `MeuGrana é o app de parcelas e finanças para ${IOS_REQUIREMENT_PT}, feito para o Brasil. Não conecta no banco.`,
      logo: {
        "@type": "ImageObject",
        url: `${SITE}/images/app-icon.png`,
        width: 1024,
        height: 1024,
      },
      areaServed: { "@type": "Country", name: "BR" },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "support@12f.dk",
        availableLanguage: ["Portuguese", "English"],
      },
      sameAs: [APP_STORE_URL, "https://12f.dk"],
      // Ties the brand entity to the author entity defined on /sobre.html.
      founder: { "@id": PERSON_ID },
    },
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      name: "MeuGrana",
      url: `${SITE}/`,
      description: SITE_DESCRIPTION,
      inLanguage: "pt-BR",
      publisher: { "@id": ORG_ID },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR" data-i18n-enabled={i18n ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#006B4F" />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="text/plain" href={`${SITE}/llms.txt`} title="Resumo do MeuGrana para modelos de linguagem" />
    <link rel="alternate" type="text/plain" href={`${SITE}/ai.txt`} title="Fatos do MeuGrana para respostas de IA" />
    <link rel="alternate" type="application/rss+xml" title="Blog do MeuGrana" href={`${SITE}/rss.xml`} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    {siteStylesheet && <link rel="stylesheet" href="/css/style.css" />}

    <!-- Brand entity graph (Organization + WebSite) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteEntities)} />

    <slot name="head" />

    {
      analytics && (
        // Production-hostname guard: local dev (localhost/127.0.0.1/preview domains)
        // never reports to the meugrana.12f.dk production site.
        <script
          is:inline
          define:vars={{ umamiHost: "meugrana.12f.dk", umamiWebsiteId: "6c5c421d-2eb8-4e0e-b1a3-3d945360f67f" }}
        >
          (function () {
            var d = document;
            if (
              location.hostname === umamiHost ||
              location.hostname === "www." + umamiHost
            ) {
              var s = d.createElement("script");
              s.defer = true;
              s.src = "https://umami.robert-jensen.dk/script.js";
              s.dataset.websiteId = umamiWebsiteId;
              s.dataset.performance = "true";
              d.head.appendChild(s);
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
