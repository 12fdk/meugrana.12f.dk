---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Screenshots from "../components/Screenshots.astro";
import Testimonials from "../components/Testimonials.astro";
import VsSpreadsheet from "../components/VsSpreadsheet.astro";
import Personas from "../components/Personas.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import FromTheBlog from "../components/FromTheBlog.astro";
import InlineCta from "../components/InlineCta.astro";
import StickyDownload from "../components/StickyDownload.astro";
import DownloadCta from "../components/DownloadCta.astro";
import Footer from "../components/Footer.astro";
import { SITE, ORG_ID, APP_STORE_URL, PRICE_BRL, SITE_DESCRIPTION, IOS_REQUIREMENT_EN } from "../consts";
import { fetchAppStoreData, MIN_RATING_COUNT } from "../utils/appStoreData";

const title = "MeuGrana — Controle de Parcelas e Cartão de Crédito";
// Kept deliberately free-plan-safe: the *12-month* projection is Premium
// (see Pricing.astro), so the description promises only "próximas faturas".
const description = SITE_DESCRIPTION;

const appStore = await fetchAppStoreData();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "MeuGrana",
  alternateName: "MeuGrana: Parcelas & Finanças",
  operatingSystem: IOS_REQUIREMENT_EN,
  applicationCategory: "FinanceApplication",
  description,
  url: `${SITE}/`,
  image: `${SITE}/images/og-image.jpg`,
  screenshot: [1, 2, 3, 4, 5].map((n) => `${SITE}/images/screenshots/pt-BR/screenshot-${n}.png`),
  // Premium-only items are labeled. The full 12-month projection is not free.
  featureList: [
    "Acompanhamento de parcelas por cartão",
    "Projeção das próximas faturas no plano grátis; projeção completa de 12 meses no Premium",
    "PIX, boleto e vale-refeição",
    "Dashboard mensal e gráficos de gastos por categoria",
    "Alertas de fechamento e vencimento",
    "Widget de resumo do mês no plano grátis; demais widgets no Premium",
    "Categorias personalizadas (Premium)",
    "Relatórios e tendências (Premium)",
    "Exportação CSV (Premium)",
    "Sincronização via iCloud pessoal (Premium)",
    "Modo escuro (Premium)",
    "Leitura de comprovante no próprio iPhone",
  ],
  inLanguage: ["pt-BR", "en-US"],
  availableCountry: "BR",
  offers: [
    {
      "@type": "Offer",
      price: "0",
      priceCurrency: "BRL",
      name: "Grátis",
      url: APP_STORE_URL,
      availability: "https://schema.org/InStock",
      eligibleRegion: { "@type": "Country", name: "BR" },
    },
    {
      "@type": "Offer",
      price: PRICE_BRL,
      priceCurrency: "BRL",
      name: "Premium (Acesso Vitalício)",
      description: "Compra única, acesso vitalício. Não é assinatura.",
      url: APP_STORE_URL,
      availability: "https://schema.org/InStock",
      eligibleRegion: { "@type": "Country", name: "BR" },
    },
  ],
  installUrl: APP_STORE_URL,
  author: { "@id": ORG_ID },
  publisher: { "@id": ORG_ID },
  // Only claim a rating once there are enough reviews to be credible.
  ...(appStore.rating > 0 && appStore.ratingCount >= MIN_RATING_COUNT
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: appStore.rating.toFixed(1),
          ratingCount: appStore.ratingCount,
          bestRating: "5",
        },
      }
    : {}),
};
---

<Layout title={title} description={description} canonical={`${SITE}/`} i18n>
  <Fragment slot="head">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {/* No hreflang: the EN translation is client-side only (js/main.js), so
        there is no distinct EN URL to annotate. hreflang variants pointing at
        the same URL are invalid. Reinstate if a prerendered /en/ page ships. */}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/images/og-image.jpg`} />
    <meta property="og:image:alt" content="MeuGrana — controle de parcelas e cartão de crédito no iPhone" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:site_name" content="MeuGrana" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/images/og-image.jpg`} />
    <meta name="twitter:image:alt" content="MeuGrana — controle de parcelas e cartão de crédito no iPhone" />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Navbar langToggle />

  <main>
    <Hero rating={appStore.rating} ratingCount={appStore.ratingCount} />
    <Features />
    <HowItWorks />
    <Screenshots />
    <InlineCta placement="after-screenshots" />
    <Testimonials rating={appStore.rating} ratingCount={appStore.ratingCount} />
    <VsSpreadsheet />
    <Personas />
    <InlineCta placement="after-personas" />
    <Pricing />
    <Faq />
    <FromTheBlog />
    <DownloadCta />
  </main>

  <Footer />
  <StickyDownload />

  <script is:inline src="/js/main.js"></script>
</Layout>
