---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import {
  SITE,
  ORG_ID,
  WEBSITE_ID,
  PERSON_ID,
  ABOUT_URL,
  AUTHOR_BIO,
  APP_STORE_BADGE_URL,
  appStoreBlogUrl,
} from "../../consts";
import { getPublishedPosts, postUrl, formatDate, type BlogPost } from "../../utils/blog";
import { readingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: BlogPost;
  allPosts: BlogPost[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const canonical = `${SITE}${postUrl(post)}`;
const minutes = readingTime(post.body ?? "");

// Related: every curated slug (they are the internal links). If a post has
// none, fall back to the 3 newest other posts.
const explicitRelated = post.data.relatedSlugs
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter((p): p is BlogPost => Boolean(p));
const related =
  explicitRelated.length > 0
    ? explicitRelated
    : allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const ogImage = post.data.cover ? `${SITE}${post.data.cover}` : `${SITE}/images/og-image.jpg`;
// Blog covers are 1200×700; the site-wide OG fallback is 1200×630.
const ogImageHeight = post.data.cover ? 700 : 630;
const imageAlt = post.data.coverAlt ?? post.data.title;
const publishedDay = post.data.publishDate.toISOString().slice(0, 10);
const modifiedDay = (post.data.updatedDate ?? post.data.publishDate).toISOString().slice(0, 10);
const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  inLanguage: "pt-BR",
  isAccessibleForFree: true,
  datePublished: publishedDay,
  dateModified: modifiedDay,
  wordCount,
  timeRequired: `PT${minutes}M`,
  author: {
    "@type": "Person",
    "@id": PERSON_ID,
    name: post.data.author,
    url: ABOUT_URL,
    description: AUTHOR_BIO,
  },
  publisher: {
    "@type": "Organization",
    "@id": ORG_ID,
    name: "MeuGrana",
    url: `${SITE}/`,
    logo: {
      "@type": "ImageObject",
      url: `${SITE}/images/app-icon.png`,
      width: 1024,
      height: 1024,
    },
  },
  image: {
    "@type": "ImageObject",
    url: ogImage,
    width: 1200,
    height: ogImageHeight,
    caption: imageAlt,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  isPartOf: { "@id": WEBSITE_ID },
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags.join(", ") } : {}),
  ...(post.data.keyword ? { articleSection: post.data.keyword } : {}),
};

// FAQPage JSON-LD from the same frontmatter that renders the visible
// "Perguntas frequentes" section below the post body.
const faqData =
  post.data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: "pt-BR",
        mainEntity: post.data.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

// Mirrors the visible breadcrumb trail rendered above the title.
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: canonical },
  ],
};
---

<Layout title={`${post.data.title} — MeuGrana`} description={post.data.description} canonical={canonical}>
  <Fragment slot="head">
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MeuGrana" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    <meta property="article:modified_time" content={(post.data.updatedDate ?? post.data.publishDate).toISOString()} />
    <meta property="article:author" content={ABOUT_URL} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="author" content={post.data.author} />
    <link rel="author" href={ABOUT_URL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.data.title} />
    <meta name="twitter:description" content={post.data.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
    {faqData && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqData)} />}
  </Fragment>

  <Navbar root />

  <main class="blog-post">
    <article class="container">
      <header class="blog-post-header">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Início</a>
          <span aria-hidden="true"> / </span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{post.data.title}</span>
        </nav>
        <h1>{post.data.title}</h1>
        <p class="blog-meta">
          <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
            {formatDate(post.data.publishDate)}
          </time>
          {" · "}{minutes} min de leitura · {post.data.author}
        </p>
      </header>

      {
        post.data.cover && (
          <img
            class="blog-post-cover"
            src={post.data.cover}
            alt={post.data.coverAlt ?? ""}
            width="1200"
            height="700"
            loading="eager"
          />
        )
      }

      <div class="blog-content">
        <Content />
      </div>

      {
        post.data.faq.length > 0 && (
          <section class="blog-content blog-faq">
            <h2>Perguntas frequentes</h2>
            {post.data.faq.map((f) => (
              <>
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </>
            ))}
          </section>
        )
      }

      <aside class="blog-cta">
        <img src="/images/app-icon.png" alt="" width="48" height="48" />
        <div>
          <strong>Controle suas parcelas com o MeuGrana</strong>
          <p>Grátis para baixar · Sem cadastro · Dados só no seu iPhone</p>
        </div>
        <a
          href={appStoreBlogUrl(post.id)}
          class="app-store-badge"
          aria-label="Download on the App Store"
          data-umami-event="app-store-click"
          data-umami-event-placement={`blog-${post.id}`}
        >
          <img src={APP_STORE_BADGE_URL} data-badge alt="Download on the App Store" height="44" />
        </a>
      </aside>

      <aside class="blog-author">
        <p class="blog-author-label">Sobre o autor</p>
        <strong>{post.data.author}</strong>
        <p>
          {AUTHOR_BIO} <a href="/sobre.html" rel="author">Sobre o autor e o MeuGrana</a>.
        </p>
      </aside>

      {
        related.length > 0 && (
          <section class="blog-related">
            <h2>Leia também</h2>
            <ul>
              {related.map((p) => (
                <li>
                  <a href={postUrl(p)}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>

  <Footer root />

  <script is:inline src="/js/main.js"></script>
</Layout>
